msgid "{title}: locked."
msgstr "{title}：未解锁。"

#. placeholders: {points_words}
msgid "The Frost Fair: best {points_words}."
msgstr "Frost Fair：最高分{points_words}。"

msgid "The Frost Fair: not skated yet."
msgstr "Frost Fair：还没滑过。"

msgid "1 Frost Fair ribbon"
msgstr "1条Frost Fair绶带"

#. placeholders: {n}
msgid "{n} Frost Fair ribbons"
msgstr "{n}条Frost Fair绶带"

#. placeholders: {b}, {LANTERN_PAIRS}, {whole_tunes}
msgid ""
"Lantern skate: best {b} of {LANTERN_PAIRS} in order, the whole tune "
"{whole_tunes} times."
msgstr "灯笼滑冰：最好成绩按顺序拿到{b}对，共{LANTERN_PAIRS}对，完整曲子{whole_tunes}次。"

msgid "Lantern skate: not skated yet."
msgstr "灯笼滑冰：还没滑过。"

#. placeholders: {stars_words}, {join}, {fair}, {lanterns}
msgid "Records. {stars_words} in all. {join} {fair} {lanterns}"
msgstr "纪录。总共{stars_words}。{join}{fair}{lanterns}"

#. placeholders: {stars_words}
#. one sentence of a longer line
msgid "{stars_words} in all."
msgstr "总共{stars_words}。"

#. placeholders: {cracks}
#. one sentence of a longer line
msgid "Cracks in the ice: {cracks}."
msgstr "冰面裂开：{cracks}次。"

#. placeholders: {lanterns}
#. one sentence of a longer line
msgid "Lanterns taken: {lanterns}."
msgstr "拿到的灯笼：{lanterns}盏。"

#. placeholders: {best_line}
#. one sentence of a longer line
msgid "Longest line: {best_line}."
msgstr "最长连串：{best_line}。"

#. placeholders: {spins}
#. one sentence of a longer line
msgid "Spins landed: {spins}."
msgstr "成功落地的旋转：{spins}次。"

