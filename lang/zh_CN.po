msgid "A rough brown cup for calm and smoky teas."
msgstr "一个粗糙的棕色杯子，适合安神和烟熏的茶。"

msgid "glass"
msgstr ""

msgid "Glass cup"
msgstr "玻璃杯"

msgid "A clear glass for fresh and bright teas."
msgstr "一个透明的玻璃杯，适合清新和清亮的茶。"

msgid "porcelain"
