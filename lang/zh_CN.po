#. one sentence of a longer line
msgid "{sentence_start} and {r} turn the bow, 5 degrees a press."
msgstr "{sentence_start}和{r}转动弓，每按一次5度。"

#. placeholders: {sentence_start}, {r}, {u}
msgid ""
"{sentence_start} and {r} turn the bow, 5 degrees a press. The sky turns "
"with you. Turn the bow, then {u} faces straight ahead again."
msgstr "{sentence_start}和{r}转动弓，每按一次5度。天空跟着你转。转动弓，然后{u}重新面向正前方。"

msgid "The bow faces straight ahead again."
msgstr "弓重新面向正前方了。"

