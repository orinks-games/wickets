msgstr "{name}，已解锁{unlocked}首，共{listed}首"

#. one sentence of a longer line
msgid "A track unlocks the first time it plays in a game."
msgstr "一首曲目在游戏中第一次播放时解锁。"

#. placeholders: {name}
#. one sentence of a longer line
msgid "Music from {name}."
msgstr "来自{name}的音乐。"

#. placeholders: {name}
msgid ""
"Music from {name}. A track unlocks the first time it plays in a game."
msgstr "来自{name}的音乐。一首曲目在游戏中第一次播放时解锁。"

