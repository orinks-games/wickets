msgstr "Tus canciones de Lantern Lake"

#. placeholders: {date_words}, {joins}, {s_ending}, {else}
msgid ""
"Your song from {date_words}, {joins} voice{s_ending}{else}, as you heard it."
msgstr ""
"Tu canción del {date_words}, {joins} {joins:voz|voces}{else}, tal como la "
"oíste."

msgid ", whole"
msgstr ", completa"

#. one clause of a longer line
msgid "whole"
msgstr "completa"

msgid "Stay out a little longer: a lantern is still on the lake."
msgstr "Quédate un poco más: aún queda un farolillo en el lago."

#. one sentence of a longer line
msgid "Hold it to keep paddling."
msgstr "Mantenla para seguir remando."

