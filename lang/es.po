msgid ""
"Up and Down choose a street, Enter dances it, Escape goes back. A street "
"opens when the one before has a star."
msgstr ""
"Up y Down eligen una calle, Enter la baila, Escape vuelve. Una calle se "
"abre cuando la anterior tiene una estrella."

#. placeholders: {base}
msgid "{base}, new"
msgstr "{base}, nueva"

#. placeholders: {n}
#. one sentence of a longer line
msgid "Earn a star on street {n} to open it."
