msgstr "Nuevo récord {relaxed}de {name}: {score}, superando {previous}."

#. placeholders: {relaxed}, {name}, {best}
msgid "Your {relaxed}best {name} score stays {best}."
msgstr "Tu récord {relaxed}de {name} sigue en {best}."

#. placeholders: {number}
msgid "night crossing {number}"
