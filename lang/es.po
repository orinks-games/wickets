msgstr "De vez en cuando la puerta de un coche aparcado va a abrirse."

#. one sentence of a longer line
msgid "Pass both doors."
msgstr "Pasa las dos puertas."

#. placeholders: {sentence_start}
#. one sentence of a longer line
msgid "{sentence_start} steers left: move out before it does."
msgstr ""
"{sentence_start} gira a la izquierda: apártate antes de que se abra."

#. placeholders: {LESSONS}
#. one sentence of a longer line
msgid "Lesson 5 of {LESSONS}: hop."
msgstr "Lección 5 de {LESSONS}: saltar."

#. placeholders: {LESSONS}, {sentence_start}
msgid ""
"Lesson 5 of {LESSONS}: hop. {sentence_start} hops while you are moving. Two "
"potholes lie in the bike lane: hop one of them as you reach it."
msgstr ""
"Lección 5 de {LESSONS}: saltar. {sentence_start} salta mientras te mueves. "
"Hay dos baches en el carril bici: salta uno de ellos al llegar."

#. one sentence of a longer line
msgid "Two potholes lie in the bike lane: hop one of them as you reach it."
msgstr "Hay dos baches en el carril bici: salta uno de ellos al llegar."

