msgstr ""

#: games/neon-rail/src/screens.rs
msgid "Fly the same mode again at once."
msgstr ""

#: games/neon-rail/src/screens.rs
msgid "Pilot progress"
msgstr ""

#: games/neon-rail/src/screens.rs
msgid "Your rank, credits, best score and unlocked bonuses."
msgstr ""

