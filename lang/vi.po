msgid "Music drifts up through the skylight from the evening show."
msgstr "Tiếng nhạc từ buổi diễn tối vọng lên qua giếng trời."

msgid "The flower market"
msgstr "Chợ hoa"

msgid "The stalls are packing up, and petals blow across the tiles."
msgstr "Các quầy hàng đang dọn, và cánh hoa bay khắp nền gạch."

msgid "The cathedral roof"
msgstr "Mái nhà thờ lớn"

msgid "The highest roof in town. The whole sky is yours."
msgstr "Mái nhà cao nhất thị trấn. Cả bầu trời là của bạn."

msgid "The bridge"
msgstr "Cây cầu"

msgid "Lanterns sway on the bridge, and the river hums below."
msgstr "Đèn lồng đung đưa trên cầu, và dòng sông rì rầm bên dưới."

msgid "The fountain square"
msgstr "Quảng trường đài phun nước"

msgid "Couples throw coins in the fountain. Every one is a wish."
msgstr "Các cặp đôi ném xu vào đài phun nước. Mỗi đồng xu là một điều ước."

msgid "The rooftop cafe"
msgstr "Quán cà phê trên mái"

msgid "A violin plays somewhere below, and cups clink."
msgstr "Đâu đó bên dưới có tiếng vĩ cầm, và tách chén lanh canh."

msgid "The highest roof in town"
msgstr "Mái nhà cao nhất thị trấn"

msgid "The moon is full and the sky is gold with hearts."
msgstr "Trăng tròn và bầu trời vàng rực tim."

msgid "The chimney tops"
msgstr "Những đỉnh ống khói"

msgid "The moon climbs, and the hearts drift faster."
msgstr "Trăng lên cao, và tim trôi nhanh hơn."

msgid "Owls call from the chimneys."
msgstr "Cú gọi nhau từ các ống khói."

msgid "The weather vane"
msgstr "Chong chóng gió"

msgid "The water tower"
msgstr "Tháp nước"

msgid "Clouds slide past the moon, and the sky goes silver."
msgstr "Mây trôi qua mặt trăng, và bầu trời ánh bạc."

msgid "The old mill"
msgstr "Cối xay cũ"

msgid "The town is asleep. Only the hearts are awake."
msgstr "Thị trấn đã ngủ. Chỉ có những trái tim còn thức."

msgid "a breeze"
msgstr "làn gió"

msgid "a far sky"
msgstr "bầu trời xa"

msgid "a crowded sky"
msgstr "bầu trời đông đúc"

msgid "sweethearts"
msgstr "tình nhân"

msgid "hearts drift half again as fast"
msgstr "tim trôi nhanh gấp rưỡi"

msgid "every heart is far off, worth 30 each"
msgstr "mọi trái tim đều ở xa, mỗi trái được 30"

msgid "two more hearts share the sky"
msgstr "thêm hai trái tim cùng trên trời"

msgid "sweetheart pairs are worth double"
msgstr "cặp tình nhân được gấp đôi"

msgid "One long round."
msgstr "Một vòng dài."

msgid "The town square"
msgstr "Quảng trường thị trấn"

msgid "The practice field"
msgstr "Bãi tập"

msgid "A quiet field with one slow heart at a time."
msgstr "Một bãi đất yên tĩnh, mỗi lần một trái tim chậm."

