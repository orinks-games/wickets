msgid ""
"Keys 1 through 4 launch fireworks: 1 boom, 2 crackle, 3 whistle, 4 sparkle."
msgstr ""
"Phím 1 tới 4 bắn pháo hoa: 1 pháo nổ, 2 pháo lách tách, 3 pháo huýt, 4 pháo "
"lấp lánh."

msgid "quickstep"
msgstr "nhịp nhanh"

msgid "tough crowd"
