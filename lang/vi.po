"Easter morning, round {round} of {EASTER_ROUNDS}: {easter_round_name}."
msgstr ""
"Sáng Phục sinh, vòng {round} trên {EASTER_ROUNDS}: {easter_round_name}."

#. placeholders: {seconds}
