#. one sentence of a longer line
msgid "Every street of the parade, with your stars."
msgstr "Mọi con phố của đoàn diễu hành, kèm số sao của bạn."

#. placeholders: {opened}, {STREETS}
msgid ""
"Every street of the parade, with your stars. {opened} of {STREETS} open."
msgstr ""
"Mọi con phố của đoàn diễu hành, kèm số sao của bạn. Đã mở {opened} trên "
"{STREETS} con phố."

#. placeholders: {opened}, {STREETS}
#. one sentence of a longer line
