msgid "I'd give anything for a proper oven again."
msgstr "Tôi sẵn lòng đổi bất cứ thứ gì để lại có một cái lò nướng tử tế."

msgid "{name} has flour from the mill, and says the oven comes next."
msgstr "{name} đã có bột từ cối xay, và nói tiếp theo là cái lò."

#. one sentence of a longer line
msgid "The whole lane smells of bread."
msgstr "Cả con đường thơm mùi bánh mì."

#. placeholders: {name}
#. one sentence of a longer line
msgid "{name} lit the bakery oven for the first time."
msgstr "{name} đã nhóm lò bánh lần đầu."

msgid ""
"{name} lit the bakery oven for the first time. The whole lane smells of "
"bread."
msgstr "{name} đã nhóm lò bánh lần đầu. Cả con đường thơm mùi bánh mì."

#. one sentence of a longer line
msgid "Everyone had a slice."
msgstr "Ai cũng có một lát."

#. placeholders: {name}
#. one sentence of a longer line
msgid "{name} baked a loaf as big as a cartwheel for the festival."
msgstr "{name} nướng một ổ bánh to bằng bánh xe bò cho lễ hội."

msgid ""
"{name} baked a loaf as big as a cartwheel for the festival. Everyone had a "
"slice."
msgstr ""
"{name} nướng một ổ bánh to bằng bánh xe bò cho lễ hội. Ai cũng có một lát."

msgid "the first loaf tin from the bakery"
msgstr "cái khuôn bánh đầu tiên của lò bánh"

msgid "I miss the sea. A boat on the river would do."
msgstr "Tôi nhớ biển. Một con thuyền trên sông cũng được."

msgid ""
"{name} has the wood for a boat, and is drawing it out on the barn floor."
msgstr "{name} đã có gỗ đóng thuyền, và đang vẽ phác trên sàn nhà kho."

msgid "{name} built a little rowing boat in the workshop."
msgstr "{name} đã đóng một chiếc thuyền chèo nhỏ trong xưởng mộc."

msgid "{name} rowed down the river at dawn and came back singing."
msgstr ""
"{name} chèo thuyền xuôi sông lúc rạng sáng và trở về vừa đi vừa hát."

msgid "a carved oar with a sailor's knot"
msgstr "mái chèo chạm khắc có nút thắt thủy thủ"

msgid "A hamlet ought to have a school, even a small one."
msgstr "Xóm nào cũng nên có một trường học, dù nhỏ thôi."

msgid "{name} says there are enough of us now for lessons on the green."
msgstr "{name} nói giờ đã đủ người để học trên bãi cỏ."

msgid ""
"{name} holds lessons in the inn's back room, and visitors' children join in."
msgstr ""
"{name} dạy học ở phòng sau của quán trọ, và con của khách cũng vào học."

#. one sentence of a longer line
msgid "Nobody missed a word."
msgstr "Không ai quên một chữ nào."

#. placeholders: {name}
#. one sentence of a longer line
msgid "{name}'s pupils sang a song at the festival."
msgstr "Học trò của {name} hát một bài ở lễ hội."

msgid "{name}'s pupils sang a song at the festival. Nobody missed a word."
msgstr "Học trò của {name} hát một bài ở lễ hội. Không ai quên một chữ nào."

msgid "a slate with everyone's names on it"
msgstr "tấm bảng đá có tên của mọi người"

msgid "The clock over the gate stopped years ago. I could mend it."
msgstr "Đồng hồ trên cổng đã ngừng chạy từ nhiều năm trước. Tôi sửa được."

msgid "{name} set up a bench in the workshop for the clock's parts."
msgstr "{name} kê một cái bàn trong xưởng mộc để đặt các bộ phận đồng hồ."

msgid "{name} built a ladder up to the gate clock."
msgstr "{name} đóng một cái thang lên đồng hồ trên cổng."

#. one sentence of a longer line
msgid "It chimed for the first time in years."
msgstr "Nó điểm chuông lần đầu sau bao năm."

#. placeholders: {name}
#. one sentence of a longer line
msgid "{name} wound the gate clock on festival night."
msgstr "{name} lên dây đồng hồ cổng vào đêm lễ hội."

msgid ""
"{name} wound the gate clock on festival night. It chimed for the first time "
"in years."
msgstr ""
"{name} lên dây đồng hồ cổng vào đêm lễ hội. Nó điểm chuông lần đầu sau bao "
"năm."

msgid "an old brass clock key"
msgstr "chiếc chìa lên dây đồng hồ bằng đồng cũ"

msgid "I'd like a flock again. Even two or three."
msgstr "Tôi muốn lại có một đàn cừu. Hai ba con cũng được."

msgid "{name} says the hens are doing well, and the goat next."
msgstr "{name} nói đàn gà đang khỏe, tiếp theo là con dê."

msgid "{name} keeps the goat's milk cool in the new dairy."
msgstr "{name} giữ sữa dê mát trong nhà làm sữa mới."

msgid "{name} made the hamlet's first cheese and named it after the goat."
msgstr "{name} làm bánh phô mai đầu tiên của xóm và đặt tên theo con dê."

msgid "a shepherd's crook with a bell on it"
msgstr "cây gậy chăn cừu có gắn chuông"

msgid "Every hamlet needs a good bench to sit on."
msgstr "Xóm nào cũng cần một chiếc ghế dài tốt để ngồi."

msgid "{name} has picked the oak for the bench."
msgstr "{name} đã chọn gỗ sồi để đóng ghế."

msgid "{name} made a long bench for the green."
msgstr "{name} đóng một chiếc ghế dài cho bãi cỏ."

msgid "{name} carved everyone's initials into the bandstand rail."
msgstr ""
"{name} khắc chữ cái đầu tên của mọi người lên lan can sân khấu nhạc."

msgid "a curl of oak shaving, kept in a matchbox"
msgstr "một lọn phoi gỗ sồi, cất trong hộp diêm"

msgid "I want to play somewhere people can dance."
msgstr "Tôi muốn chơi nhạc ở nơi mọi người có thể nhảy."

msgid "{name} says there are enough of us for a proper dance now."
msgstr "{name} nói giờ đã đủ người cho một buổi khiêu vũ đàng hoàng."

#. one sentence of a longer line
msgid "Feet were tapping all down the lane."
msgstr "Cả con đường rộn tiếng chân gõ nhịp."

#. placeholders: {name}
#. one sentence of a longer line
msgid "{name} played the bandstand's first night."
msgstr "{name} chơi đêm đầu tiên ở sân khấu nhạc."

msgid ""
"{name} played the bandstand's first night. Feet were tapping all down the "
"lane."
msgstr ""
"{name} chơi đêm đầu tiên ở sân khấu nhạc. Cả con đường rộn tiếng chân gõ "
"nhịp."

msgid "{name} wrote a tune called Larkfield and played it at the festival."
msgstr "{name} viết một khúc nhạc tên là Larkfield và chơi ở lễ hội."

msgid "a fiddle string tied in a bow"
msgstr "sợi dây đàn vĩ cầm thắt nơ"

msgid "A place to rest when you're ill, that's what's missing."
msgstr "Một chỗ nghỉ khi ốm, đó là thứ còn thiếu."

msgid "{name} keeps two beds aired at the inn for anyone poorly."
msgstr ""
"{name} giữ hai chiếc giường thoáng sạch ở quán trọ cho ai không khỏe."

msgid "{name} has a cupboard of bread and broth for the sick room."
msgstr "{name} có một tủ bánh mì và cháo cho phòng người ốm."

msgid "{name} says nobody in Larkfield has missed a day's work this week."
msgstr "{name} nói tuần này ở Larkfield không ai phải nghỉ làm ngày nào."

msgid "a jar of dried camomile"
msgstr "một lọ hoa cúc khô"

