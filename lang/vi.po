msgstr "Tab: turn."

msgid "Up arrow: dance forward."
msgstr "Mũi tên Up: nhảy forward."

msgid "Down arrow: dance back."
msgstr "Mũi tên Down: nhảy back."

msgid ""
"S: status: the tune, the bar, your score and your streak, and your luck in "
"Saint Patrick's week."
msgstr ""
"S: trạng thái: giai điệu, ô nhịp, điểm và chuỗi, và may mắn trong tuần "
