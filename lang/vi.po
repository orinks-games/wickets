msgstr ""
"{sentence_start} chuyển xuống quả chuông kế trên thang âm, {d} để lên lại. "
"Chuông 1, chuông cao, là cao nhất. Đổi chuông cho đến khi tới chuông 6, "
"chuông trầm, thấp nhất."

#. one sentence of a longer line
msgid "Move to place 2."
msgstr "Chuyển đến vị trí 2."

#. one sentence of a longer line
