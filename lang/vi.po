msgid ""
"{sentence_start} steps forward and {d} steps back; {l} and {r} turn you. "
"Birds sing from their true place. Walk toward the chickadee until it sings "
"to you."
msgstr ""
"{sentence_start} để bước tới và {d} để lùi; {l} và {r} để xoay. Chim hót từ "
