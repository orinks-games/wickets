msgid ""
"Gift Sort shifts {WEEKLY_SHIFTS} to {WEEKLY_SHIFTS2}, then the Wish Desk, "
"{name}"
msgstr ""
"Phân loại quà ca {WEEKLY_SHIFTS} đến {WEEKLY_SHIFTS2}, rồi Bàn Điều Ước, "
"{name}"

#. placeholders: {MONTHLY_STACKS}, {MONTHLY_STACKS2}
msgid ""
"the Wish Desk, stacks {MONTHLY_STACKS} to {MONTHLY_STACKS2}, every box in "
"straw"
msgstr ""
"Bàn Điều Ước, chồng thư {MONTHLY_STACKS} đến {MONTHLY_STACKS2}, hộp nào "
"cũng lót rơm"

msgid "Today's twist"
msgstr "Điểm khác lạ hôm nay"

msgid "This week's twist"
msgstr "Điểm khác lạ tuần này"

msgid "This month's rule"
msgstr "Luật tháng này"

#. placeholders: {DAILY_SHIFT}
#. one sentence of a longer line
msgid "One Gift Sort shift at shift {DAILY_SHIFT}."
msgstr "Một ca Phân loại quà ở ca {DAILY_SHIFT}."

#. placeholders: {DAILY_SHIFT}
msgid ""
"One Gift Sort shift at shift {DAILY_SHIFT}. Sort the whole order before the "
"clock runs out."
msgstr ""
"Một ca Phân loại quà ở ca {DAILY_SHIFT}. Phân loại hết đơn hàng trước khi "
"hết giờ."

#. one sentence of a longer line
msgid "Sort the whole order before the clock runs out."
msgstr "Phân loại hết đơn hàng trước khi hết giờ."

#. one sentence of a longer line
msgid "Fewer shakes and no wrong boxes score more."
msgstr "Lắc ít hơn và không chọn sai hộp thì được nhiều điểm hơn."

#. placeholders: {DAILY_STACK}
#. one sentence of a longer line
msgid "One stack of letters at the Wish Desk, stack {DAILY_STACK}."
msgstr "Một chồng thư ở Bàn Điều Ước, chồng thư {DAILY_STACK}."

#. placeholders: {DAILY_STACK}
msgid ""
"One stack of letters at the Wish Desk, stack {DAILY_STACK}. Fewer shakes "
"and no wrong boxes score more."
msgstr ""
"Một chồng thư ở Bàn Điều Ước, chồng thư {DAILY_STACK}. Lắc ít hơn và không "
"chọn sai hộp thì được nhiều điểm hơn."

#. one sentence of a longer line
msgid "Both scores add up."
msgstr "Cộng cả hai điểm."

#. placeholders: {WEEKLY_SHIFTS}, {WEEKLY_SHIFTS2}, {WEEKLY_STACK}
#. one sentence of a longer line
msgid ""
"Gift Sort shifts {WEEKLY_SHIFTS} to {WEEKLY_SHIFTS2}, then stack "
"{WEEKLY_STACK} at the Wish Desk."
msgstr ""
"Phân loại quà ca {WEEKLY_SHIFTS} đến {WEEKLY_SHIFTS2}, rồi chồng thư "
"{WEEKLY_STACK} ở Bàn Điều Ước."

#. placeholders: {WEEKLY_SHIFTS}, {WEEKLY_SHIFTS2}, {WEEKLY_STACK}
msgid ""
"Gift Sort shifts {WEEKLY_SHIFTS} to {WEEKLY_SHIFTS2}, then stack "
"{WEEKLY_STACK} at the Wish Desk. Both scores add up. The twist is on the "
"belt."
msgstr ""
"Phân loại quà ca {WEEKLY_SHIFTS} đến {WEEKLY_SHIFTS2}, rồi chồng thư "
"{WEEKLY_STACK} ở Bàn Điều Ước. Cộng cả hai điểm. Điểm khác lạ nằm ở băng "
"chuyền."

#. one sentence of a longer line
msgid "The twist is on the belt."
msgstr "Điểm khác lạ nằm ở băng chuyền."

#. placeholders: {MONTHLY_STACKS}, {MONTHLY_STACKS2}
msgid ""
"Stacks {MONTHLY_STACKS} to {MONTHLY_STACKS2} at the Wish Desk, one after "
"another."
