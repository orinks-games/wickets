msgstr "Làn {lane} trên {lanes}, ở xe đẩy, giỏ {basket} trên {capacity}."

#. placeholders: {lane}, {lanes}, {basket}, {capacity}
msgid "Lane {lane} of {lanes}, basket {basket} of {capacity}."
msgstr "Làn {lane} trên {lanes}, giỏ {basket} trên {capacity}."

#. placeholders: {sentence_start}, {lane}, {relative}, {left}
msgid ""
"{sentence_start} in lane {lane}, {relative}, lands in {left} seconds."
msgstr ""
"{sentence_start} ở làn {lane}, {relative}, chạm đất sau {left} giây."

msgid "Getting ready."
msgstr "Đang chuẩn bị."

#. placeholders: {time_left}
msgid "{time_left} seconds left."
msgstr "Còn {time_left} giây."

#. placeholders: {banked_round}
