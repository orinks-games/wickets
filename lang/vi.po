msgstr ""
"Một chiếc đèn lồng chưa thắp trong chòm: chưa đến lượt. Hãy theo chiếc đang "
"sáng."

msgid "Sleeping lantern"
msgstr "Đèn lồng đang ngủ"

msgid "One stroke forward, on alternating sides of the canoe."
msgstr "Một nhịp chèo tới, lần lượt hai bên ca nô."

msgid "Paddle stroke"
msgstr "Nhịp chèo"

msgid "A stroke backward: it slows you, then backs you up."
msgstr "Một nhịp chèo lùi: làm bạn chậm lại, rồi lùi ra."

msgid "Back paddle"
msgstr "Chèo lùi"

msgid "A short press of a turn key: the canoe turns a little."
msgstr "Bấm nhanh phím xoay: ca nô xoay một chút."

msgid "Turning"
msgstr "Xoay"

msgid "Reeds"
msgstr "Lau sậy"

msgid "The canoe has reached the shore. Turn toward open water."
msgstr "Ca nô đã tới bờ. Xoay về phía mặt nước thoáng."

msgid "Bump"
msgstr "Va nhẹ"

msgid "The canoe nudged the island's rocks."
msgstr "Ca nô chạm nhẹ vào đá của hòn đảo."

msgid "Gliding"
msgstr "Lướt"

msgid "Water rushing past the hull: louder the faster you go."
msgstr "Nước chảy qua thân thuyền: càng đi nhanh càng to."

msgid "Frogs"
msgstr "Ếch"

msgid "Frogs singing from one place on the shore all night: a landmark."
msgstr "Ếch hát từ một chỗ trên bờ suốt đêm: một cột mốc."

msgid "Crickets"
msgstr "Dế"

msgid "Crickets in one place on the shore: another landmark."
msgstr "Dế ở một chỗ trên bờ: một cột mốc khác."

msgid "The reeds rustling at one spot on the shore."
msgstr "Lau sậy xào xạc ở một chỗ trên bờ."

msgid "Wind in the reeds"
msgstr "Gió trong lau sậy"

msgid "Owl"
msgstr "Cú"

msgid ""
"The owl on the island hoots every so often: the island is where it calls "
"from."
msgstr "Con cú trên đảo thỉnh thoảng lại kêu: hòn đảo ở nơi nó gọi."

msgid "A discovery on the shore: creaking boards and water slapping posts."
msgstr "Một khám phá trên bờ: ván kẽo kẹt và nước vỗ vào cột."

msgid "The old dock"
msgstr "Bến cũ"

msgid "A discovery out on the water: waves lapping on rocks, and an owl."
msgstr "Một khám phá ngoài mặt nước: sóng vỗ vào đá, và một con cú."

msgid "The island"
msgstr "Hòn đảo"

msgid "A discovery on the shore: a faint, twinkling shimmer."
msgstr "Một khám phá trên bờ: ánh lấp lánh mờ nhạt."

msgid "The firefly meadow"
msgstr "Đồng cỏ đom đóm"

msgid "A discovery on the shore: running, bubbling water."
msgstr "Một khám phá trên bờ: tiếng nước chảy róc rách."

msgid "The little stream"
msgstr "Con suối nhỏ"

msgid "A discovery on the water: a bullfrog and soft plops."
msgstr "Một khám phá trên mặt nước: một con ễnh ương và tiếng tõm khẽ."

msgid "The lily pads"
msgstr "Lá súng"

msgid "A discovery on the water: a low bell rocking."
msgstr "Một khám phá trên mặt nước: tiếng chuông trầm đung đưa."

msgid "The bell buoy"
msgstr "Phao chuông"

msgid "A discovery on the shore: gnawing, then a tail slap."
msgstr "Một khám phá trên bờ: tiếng gặm, rồi tiếng đập đuôi."

msgid "The beaver lodge"
msgstr "Tổ hải ly"

msgid "A discovery on the shore: leaves whispering."
msgstr "Một khám phá trên bờ: lá thì thầm."

msgid "The weeping willow"
msgstr "Cây liễu rủ"

msgid "Discovery"
msgstr "Khám phá"

msgid "You found a place. It goes in your journal."
msgstr "Bạn đã tìm thấy một chốn. Nó được ghi vào sổ tay."

msgid "Lantern Festival night"
msgstr "Đêm Nguyên Tiêu"

msgid "Lantern Festival night has ended."
msgstr "Đêm Nguyên Tiêu đã kết thúc."

