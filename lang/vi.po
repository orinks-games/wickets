msgstr "Đã mở {open_safes} trên {SAFES}."

msgid "Practice dial"
msgstr "Núm luyện tập"

msgid "Endless single wheels with nothing to lose."
msgstr "Vô số vòng số đơn mà không mất gì."

msgid ""
"Your best times and scores for every safe, and your challenge results."
msgstr ""
"Thời gian và điểm tốt nhất của bạn cho mọi két, và kết quả thử thách."

#. one sentence of a longer line
msgid ""
"A daily job, a weekly vault and a monthly heist, the same for every player."
msgstr ""
"Một phi vụ ngày, một kho tuần và một vụ trộm tháng, giống nhau cho mọi "
"người chơi."

#. placeholders: {resets}
msgid ""
"A daily job, a weekly vault and a monthly heist, the same for every player. "
"{resets}"
msgstr ""
"Một phi vụ ngày, một kho tuần và một vụ trộm tháng, giống nhau cho mọi "
"người chơi. {resets}"

msgid "Up and Down choose a safe, Enter plays it, Escape goes back."
msgstr "Up và Down chọn két, Enter chơi, Escape quay lại."

#. placeholders: {n}
msgid "Crack safe {n} to race it against the clock."
msgstr "Phá két {n} để đua giờ với nó."

#. placeholders: {n}, {n2}
msgid "Crack safe {n} to open safe {n2}."
msgstr "Phá két {n} để mở két {n2}."

#. placeholders: {n}
msgid "Safe {n}, locked"
msgstr "Két {n}, đang khóa"

#. placeholders: {n}, {name}, {t}
