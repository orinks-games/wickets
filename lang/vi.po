msgid "Dawn in the spring woods. New leaves, and the migrants are back."
msgstr "Bình minh trong rừng xuân. Lá non, và chim di cư đã về."

msgid "A warm summer dawn under the trees."
msgstr "Bình minh mùa hè ấm áp dưới tán cây."

msgid ""
"An autumn dawn. Leaves drift down, and the summer birds have gone south."
msgstr "Bình minh mùa thu. Lá rơi lả tả, và chim mùa hè đã bay về nam."

msgid "A still winter dawn. Snow on the branches, and the woods are quiet."
msgstr "Bình minh mùa đông lặng gió. Tuyết trên cành, và rừng yên ắng."

msgid "Dew on the spring meadow, and larks already up."
msgstr "Sương trên đồng cỏ mùa xuân, và sơn ca đã bay lên."

msgid "A summer meadow, tall with grass and flowers."
msgstr "Đồng cỏ mùa hè, cỏ hoa cao ngút."

msgid "A misty autumn meadow, the grass gone to seed."
msgstr "Đồng cỏ mùa thu mờ sương, cỏ đã kết hạt."

msgid "A white winter field, hushed under snow."
msgstr "Cánh đồng mùa đông trắng xóa, im lặng dưới tuyết."

msgid "The spring marsh, the reeds loud with new song."
msgstr "Đầm lầy mùa xuân, đám sậy rộn tiếng hót mới."

msgid "A summer marsh, warm and busy among the reeds."
msgstr "Đầm lầy mùa hè, ấm áp và nhộn nhịp giữa đám sậy."

msgid "An autumn marsh, the reeds turning gold."
msgstr "Đầm lầy mùa thu, sậy ngả vàng."

msgid "A frozen winter marsh, with only a few birds about."
msgstr "Đầm lầy mùa đông đóng băng, chỉ lác đác vài con chim."

msgid "The river in spring, high and quick."
msgstr "Dòng sông mùa xuân, nước lên và chảy xiết."

msgid "A slow summer river under the willows."
msgstr "Dòng sông mùa hè chảy chậm dưới hàng liễu."

msgid "An autumn river, leaves riding the current."
msgstr "Dòng sông mùa thu, lá trôi theo dòng."

msgid "A cold winter river, steaming in the dawn."
msgstr "Dòng sông mùa đông lạnh giá, bốc hơi lúc bình minh."

msgid "It noticed you, and the rest of the glade goes quiet."
msgstr "Nó đã nhận ra bạn, và cả bãi cỏ im lặng."

msgid "Stay a moment: the chickadee is waiting for you."
msgstr "Đứng lại một chút: con bạc má đầu đen đang chờ bạn."

#. one sentence of a longer line
msgid "Birds sing from their true place."
msgstr "Chim hót từ đúng vị trí của chúng."

#. one sentence of a longer line
msgid "Walk toward the chickadee until it sings to you."
msgstr "Đi về phía con bạc má đầu đen đến khi nó hót cho bạn nghe."

