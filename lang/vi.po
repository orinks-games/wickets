msgid ""
"A bare skimmer, nine sectors, one life. It keeps its own board and pays no "
"credits, parts or intel."
msgstr ""
"Tàu lướt trơn, chín khu vực, một mạng. Nó có bảng xếp hạng riêng và không "
"trả tín dụng, linh kiện hay tình báo."

msgid "Cold start"
