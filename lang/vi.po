msgstr "Bốp"

msgid "Pop: a paper heart bursts."
msgstr "Bốp: một trái tim giấy vỡ."

#. the name or the meaning of a longer line
msgid "a paper heart bursts."
msgstr "một trái tim giấy vỡ."

#. the name or the meaning of a longer line
msgid "Sweetheart chord"
msgstr "Hợp âm tình nhân"

msgid ""
"Sweetheart chord: rising chimes that end in a chord. Both hearts of a pair, "
"one after the other."
msgstr ""
"Hợp âm tình nhân: tiếng chuông đi lên kết thúc bằng một hợp âm. Trúng cả "
"hai trái tim của một cặp, liền nhau."

#. the name or the meaning of a longer line
msgid ""
"rising chimes that end in a chord. Both hearts of a pair, one after the "
"other."
msgstr ""
"tiếng chuông đi lên kết thúc bằng một hợp âm. Trúng cả hai trái tim của một "
"cặp, liền nhau."

#. the name or the meaning of a longer line
msgid "Rose caught"
msgstr "Trúng hoa hồng"

msgid "Rose caught: a rustle and a bright harp run."
msgstr "Trúng hoa hồng: tiếng xào xạc và chuỗi đàn hạc sáng."

#. the name or the meaning of a longer line
msgid "a rustle and a bright harp run."
msgstr "tiếng xào xạc và chuỗi đàn hạc sáng."

#. the name or the meaning of a longer line
msgid "Golden heart caught"
msgstr "Trúng tim vàng"

msgid "Golden heart caught: a burst of bells, high and bright."
msgstr "Trúng tim vàng: tràng chuông, cao và sáng."

#. the name or the meaning of a longer line
msgid "a burst of bells, high and bright."
msgstr "tràng chuông, cao và sáng."

#. the name or the meaning of a longer line
msgid "Note caught"
msgstr "Trúng thư"

msgid "Note caught: paper unfolding, and a soft chord. A love note to keep."
msgstr ""
"Trúng thư: tiếng giấy mở ra, và một hợp âm nhẹ. Một lá thư tình để giữ."

#. the name or the meaning of a longer line
msgid "paper unfolding, and a soft chord. A love note to keep."
msgstr "tiếng giấy mở ra, và một hợp âm nhẹ. Một lá thư tình để giữ."

#. the name or the meaning of a longer line
msgid "Miss"
msgstr "Trượt"

msgid "Miss: a far tap on roof tiles. The arrow met nothing."
msgstr "Trượt: tiếng gõ xa trên ngói. Mũi tên không trúng gì."

#. the name or the meaning of a longer line
msgid "a far tap on roof tiles. The arrow met nothing."
msgstr "tiếng gõ xa trên ngói. Mũi tên không trúng gì."

#. the name or the meaning of a longer line
msgid "Sights ping"
msgstr "Tín hiệu điểm ngắm"

msgid ""
"Sights ping: a small glassy ping. Let go now and the arrow meets a target."
msgstr ""
"Tín hiệu điểm ngắm: tiếng ping nhỏ như thủy tinh. Buông ngay thì mũi tên "
"trúng mục tiêu."

#. the name or the meaning of a longer line
msgid "a small glassy ping. Let go now and the arrow meets a target."
msgstr ""
"tiếng ping nhỏ như thủy tinh. Buông ngay thì mũi tên trúng mục tiêu."

#. the name or the meaning of a longer line
msgid "Rooftop bell"
msgstr "Chuông mái nhà"

msgid "Rooftop bell: a round begins."
msgstr "Chuông mái nhà: một vòng bắt đầu."

#. the name or the meaning of a longer line
msgid "a round begins."
msgstr "một vòng bắt đầu."

#. the name or the meaning of a longer line
msgid "Quiver spent"
msgstr "Hết tên"

msgid "Quiver spent: three falling notes. The round is over."
msgstr "Hết tên: ba nốt đi xuống. Vòng đã kết thúc."

#. the name or the meaning of a longer line
msgid "three falling notes. The round is over."
msgstr "ba nốt đi xuống. Vòng đã kết thúc."

#. the name or the meaning of a longer line
msgid "Dull tap"
msgstr "Tiếng gõ đục"

msgid "Dull tap: nothing to do."
msgstr "Tiếng gõ đục: không có gì để làm."

#. the name or the meaning of a longer line
msgid "nothing to do."
msgstr "không có gì để làm."

msgid "A heart's hum, then the chime it makes when hit."
msgstr "Tiếng ngân của trái tim, rồi tiếng chuông khi nó bị trúng."

msgid "Return to the Cupid's Quiver title."
msgstr "Về màn hình chính của Cupid's Quiver."

#. one sentence of a longer line
msgid "The sky turns with you."
msgstr "Bầu trời xoay theo bạn."

#. placeholders: {u}
#. one sentence of a longer line
msgid "Turn the bow, then {u} faces straight ahead again."
msgstr "Xoay cung, rồi {u} để nhìn thẳng phía trước lại."

#. placeholders: {sentence_start}, {r}
