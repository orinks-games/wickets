msgstr "Đã cất {banked_round} trên {n} cần cất."

msgid "Practice: nothing costs a basket."
msgstr "Luyện tập: không gì làm mất giỏ."

msgid "1 more cracked egg costs a basket."
msgstr "Thêm 1 quả trứng vỡ là mất một giỏ."

#. placeholders: {n}
msgid "{n} more cracked eggs cost a basket."
msgstr "Thêm {n} quả trứng vỡ là mất một giỏ."

#. placeholders: {score}
msgid "Score {score}."
msgstr "Điểm {score}."

#. placeholders: {streak}
