msgstr ""
"khán giả chỉ tính điểm thời điểm khi lệch trong {TOUGH_WINDOW_MS} giây."

#. placeholders: {TOUGH_WINDOW_MS}
msgid ""
"the crowd only pays for timing within {TOUGH_WINDOW_MS} seconds. Any "
"firework further off earns no timing points"
msgstr ""
"khán giả chỉ tính điểm thời điểm khi lệch trong {TOUGH_WINDOW_MS} giây. Quả "
"nào lệch hơn thì không được điểm thời điểm"

msgid "each show plays only once: no replays and no hints"
msgstr "mỗi màn chỉ phát một lần: không phát lại và không có gợi ý"

msgid ""
"fog hangs over the field, so the show's fireworks seem far off, but your "
"own launches do not"
msgstr ""
"sương phủ trên bãi, nên pháo của màn trình diễn như ở xa, nhưng các quả bạn "
"bắn thì không"

msgid "Winter Lights"
msgstr "Ánh sáng mùa đông"

msgid "Lantern Night"
msgstr "Đêm đèn lồng"

msgid "Spring Thunder"
msgstr "Sấm mùa xuân"

msgid "April Showers"
msgstr "Mưa tháng Tư"

msgid "Blossom Burst"
msgstr "Hoa nở rộ"

msgid "Midsummer Night"
msgstr "Đêm giữa hè"

msgid "Independence Day"
msgstr "Ngày Độc lập"

msgid "Summer Crackle"
msgstr "Lách tách mùa hè"

msgid "Harvest Moon"
