msgstr "Mỗi ống cố định đúng giọng được 10 điểm."

msgid "Each try at setting it while it still wobbles costs 2."
msgstr "Mỗi lần thử cố định khi nó vẫn rung mất 2."

msgid "Each hint costs 3."
msgstr "Mỗi gợi ý mất 3."

msgid "A pipe in tune always scores at least 2."
msgstr "Ống đúng giọng luôn được ít nhất 2 điểm."

msgid ""
"A pipe set at the first try with no hint counts toward your first-try total."
