msgid "Frame 1 done, a strike. Score 10, plus your next two balls."
msgstr "Xong khung 1, một strike. Điểm 10, cộng hai quả tiếp theo."

#. placeholders: {pins_words}, {down}
msgid "Frame 1, second ball, {pins_words} standing, score {down}."
msgstr "Khung 1, quả thứ hai, còn đứng {pins_words}, điểm {down}."

#. placeholders: {sentence_start}
#. one sentence of a longer line
msgid "{sentence_start} suggests a board and an aim for your next ball."
msgstr "{sentence_start} gợi ý ván đứng và hướng ngắm cho quả tiếp theo."

#. placeholders: {sentence_start}
msgid ""
"{sentence_start} suggests a board and an aim for your next ball. Press it "
"now."
msgstr ""
"{sentence_start} gợi ý ván đứng và hướng ngắm cho quả tiếp theo. Nhấn ngay "
"bây giờ."

#. placeholders: {stand}, {aim_words}
msgid "New rack: board {stand}, {aim_words}."
msgstr "Hàng ky mới: ván {stand}, {aim_words}."

msgid "Ten frames, two balls a frame. First, stand and aim"
msgstr "Mười khung, mỗi khung hai quả. Trước hết, đứng và ngắm"

msgid ""
"All ten with the first ball is a strike, and with two balls a spare. Play "
"bowls a full game, and Help explains scoring."
msgstr ""
"Đổ cả mười bằng quả đầu là strike, bằng hai quả là spare. Chơi bắt đầu một "
"trận đủ, và Trợ giúp giải thích cách tính điểm."

#. placeholders: {control_name}
#. one sentence of a longer line
msgid "Press {control_name} to swing again."
