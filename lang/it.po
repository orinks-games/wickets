msgstr "{sentence}: bloccato, {still_needed}"

msgid "Grows like a squash; in the packet until Thanksgiving."
msgstr "Cresce come una zucchina; nella bustina fino al Ringraziamento."

msgid "Pumpkin: sings a low bassoon, until Thanksgiving"
msgstr "Zucca: canta come un fagotto basso, fino al Ringraziamento"

#. placeholders: {found}, {count}
msgid "Varieties found, {found} of {count}"
msgstr "Varietà trovate, {found} di {count}"

msgid "Every variety your crosses have made. Enter on one plays its part."
msgstr ""
"Ogni varietà nata dai tuoi incroci. Enter su una suona la sua parte."

#. placeholders: {keepsakes}, {ALL}
msgid "Keepsakes, {keepsakes} of {ALL}"
msgstr "Ricordi, {keepsakes} di {ALL}"

msgid "Things for your rooftop, earned with stars."
msgstr "Cose per il tuo tetto, guadagnate con le stelle."

msgid "Requests, none"
msgstr "Richieste, nessuna"

#. placeholders: {n}
msgid "Requests, {n}"
msgstr "Richieste, {n}"

msgid "No requests. Neighbours ask as the days go by."
msgstr "Nessuna richiesta. I vicini chiedono con il passare dei giorni."

msgid ""
"What your neighbours would like from your harvests. Each one filled earns a "
"star."
msgstr ""
"Cosa vorrebbero i tuoi vicini dai tuoi raccolti. Ogni richiesta esaudita "
"vale una stella."

msgid "Return to the Rooftop Garden title."
msgstr "Torna al menu del titolo di Rooftop Garden."

msgid "Varieties found"
msgstr "Varietà trovate"

msgid ""
"Up and Down read the varieties, Enter plays one's part, Escape goes back."
msgstr ""
"Up e Down leggono le varietà, Enter suona la parte di una, Escape torna "
"indietro."

