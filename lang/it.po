msgstr "Respiri il vapore: {words}."

msgid "A guest would love it."
msgstr "A un ospite piacerebbe tantissimo."

msgid "Each tea likes its own steep, and the guest still enjoys the cup."
msgstr ""
"Ogni tè vuole la sua infusione, e all'ospite la tazza piace comunque."

#. placeholders: {seconds_words}, {words}
