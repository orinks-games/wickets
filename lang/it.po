#. placeholders: {sentence_start}, {d}, {POCKET_AT}
msgid ""
"{sentence_start} turns your aim one step right, {d} one step left. Aim "
"right until the ball would cross board {POCKET_AT}, the pocket beside the "
"head pin."
msgstr ""
"{sentence_start} gira la mira di un passo a destra, {d} di un passo a "
"sinistra. Mira a destra finché la palla passerebbe dalla tavola "
"{POCKET_AT}, la tasca accanto al birillo di testa."

#. one sentence of a longer line
msgid "You are aimed into the pocket at an angle."
msgstr "Miri in diagonale verso la tasca."

#. placeholders: {line}
msgid "{line} You are aimed into the pocket at an angle."
msgstr "{line} Miri in diagonale verso la tasca."

#. placeholders: {p}
