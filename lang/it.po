msgid ""
"Records. Most lanterns in a night: {most}.{festival} Free paddle, most "
"lanterns: {free}. Nights finished: {nights}. Outings: {outings}. Lanterns "
"gathered in all: {lanterns}. Places found: {places} of {ALL}."
msgstr ""
"Primati. Massimo di lanternini in una notte: {most}.{festival} Pagaiata "
"libera, massimo di lanternini: {free}. Notti finite: {nights}. Uscite: "
"{outings}. Lanternini raccolti in tutto: {lanterns}. Posti trovati: "
"{places} su {ALL}."

