msgid "{sentence_start} launches the chosen firework. {wheel_line}"
msgstr "{sentence_start} seçilen havai fişeği fırlatır. {wheel_line}"

msgid ""
"Keys 1 through 4 launch fireworks: 1 boom, 2 crackle, 3 whistle, 4 sparkle."
msgstr ""
"1 ile 4 arası tuşlar havai fişek fırlatır: 1 patlama, 2 çatırtı, 3 ıslık, 4 "
"ışıltı."

msgid "quickstep"
msgstr "çabuk adım"

msgid "tough crowd"
msgstr "zor seyirci"

msgid "one shot"
