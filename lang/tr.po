#. placeholders: {control_name}, {control_name2}
msgid ""
"Hold {control_name} or A to launch on the left, {control_name2} or D for "
"the right. Otherwise it goes up in the center."
msgstr ""
"Solda fırlatmak için {control_name} ya da A basılı tutun, sağ için "
