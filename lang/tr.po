msgid "Down arrow: slowdown pulse. X also works."
msgstr "Down oku: yavaşlatma darbesi. X de çalışır."

msgid "Down arrow: slowdown pulse."
msgstr "Down oku: yavaşlatma darbesi."

msgid "X also works."
msgstr "X de çalışır."

msgid "Up arrow: priority override. P also works."
msgstr "Up oku: öncelik devralma. P de çalışır."

