msgid "The night's song"
msgstr "Le morceau de la nuit"

msgid "Gather a lantern on the lake."
msgstr "Ramasse une lanterne sur le lac."

msgid "The song the lanterns sing, each voice joining in its own order."
msgstr ""
"Le morceau que chantent les lanternes, chaque voix entrant à son tour."

msgid "Lantern Festival song"
msgstr "Le morceau de la fête des lanternes"

msgid "Lantern Festival night's song, with temple bells for its last voice."
msgstr ""
"Le morceau de la nuit de la fête des lanternes, avec des cloches de temple "
"pour dernière voix."

msgid "Your Lantern Lake songs"
msgstr "Tes morceaux de Lantern Lake"

#. placeholders: {date_words}, {joins}, {s_ending}, {else}
msgid ""
"Your song from {date_words}, {joins} voice{s_ending}{else}, as you heard it."
msgstr ""
"Ton morceau du {date_words}, {joins} voix{else}, tel que tu l'as entendu."

