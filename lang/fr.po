#. placeholders: {fitted}
msgid "{fitted} fitted. This challenge's route is fixed. Enter flies on"
msgstr ""
"{fitted} installé. La route de ce défi est fixée. Enter pour repartir"

#. one sentence of a longer line
msgid "Choose your route"
msgstr "Choisis ta route"

#. placeholders: {fitted}
msgid "{fitted} fitted. Choose your route"
msgstr "{fitted} installé. Choisis ta route"

msgid "Run complete"
msgstr "Partie terminée"

msgid "Run over"
msgstr "Partie finie"

