msgstr ", complet"

#. one clause of a longer line
msgid "whole"
msgstr "complet"

msgid "Stay out a little longer: a lantern is still on the lake."
msgstr "Reste encore un peu : une lanterne est encore sur le lac."

#. one sentence of a longer line
msgid "Hold it to keep paddling."
msgstr "Tiens-la pour continuer à pagayer."

#. placeholders: {d}
