msgstr "une paire de chaussons tête de tigre"

msgid "a rabbit lantern of white paper"
msgstr "une lanterne lapin en papier blanc"

msgid "a gold dragon scale"
msgstr "une écaille de dragon dorée"

msgid "a coiled snake of red silk"
msgstr "un serpent enroulé en soie rouge"

msgid "a paper-cut galloping horse"
msgstr "un cheval au galop en papier découpé"

msgid "a woollen goat with curled horns"
msgstr "une chèvre en laine aux cornes bouclées"

msgid "a clay monkey holding a peach"
msgstr "un singe en argile tenant une pêche"

msgid "a painted rooster fan"
msgstr "un éventail peint au coq"

