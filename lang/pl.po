#. placeholders: {pantry}, {total}, {cleared}
msgid "Out of whiskers in maze {pantry} of {total}, {cleared} cleared."
msgstr ""
"Koniec wąsów w labiryncie {pantry} z {total}, oczyszczone: {cleared}."

