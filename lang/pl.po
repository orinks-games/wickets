msgstr ""
"Wrócić do domu? {tab} ponownie wraca do domu. Każdy inny klawisz idzie "
"dalej."

#. placeholders: {name}
msgid "Another walk on the {name}, with new birds."
msgstr "Kolejny spacer: {name}, z nowymi ptakami."

msgid "Another walk."
msgstr "Kolejny spacer."

msgid "Every bird you have met, with its song in words."
msgstr "Każdy spotkany ptak, z pieśnią opisaną słowami."

msgid "The same walk, straight away. Only your best result is kept."
msgstr "Ten sam spacer, od razu. Zostaje tylko twój najlepszy wynik."

#. one sentence of a longer line
msgid "Back on the trail."
msgstr "Z powrotem na szlaku."

#. placeholders: {status}
msgid "Back on the trail. {status}"
msgstr "Z powrotem na szlaku. {status}"

#. placeholders: {name}
msgid "The {name} sings again."
msgstr "{name} śpiewa ponownie."

#. placeholders: {friends}, {birds}
msgid "Befriended: {friends} of {birds}"
msgstr "Zaprzyjaźnione: {friends} z {birds}"

#. placeholders: {sentence_start}, {from_metres}
