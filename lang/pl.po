msgstr "z tyłu, na skałach"

msgid "at the water's edge"
msgstr "na skraju wody"

msgid "leaning in close"
msgstr "w pochyleniu, blisko wody"

#. placeholders: {w}
msgid "First found {w}."
msgstr "Pierwsze znalezisko: {w}."

msgid " It is shy: it hides when you lean in, until you keep still."
msgstr ""
" Jest płochliwe: chowa się, gdy się pochylasz, póki się nie uspokoisz."

#. placeholders: {w}
msgid " A rare find: it only turns up {w}."
msgstr " Rzadkie znalezisko: pojawia się tylko {w}."

