msgid ""
"Opens {leftovers_next_words}, around Thanksgiving: {TURKEY_SCRAPS} turkey "
"scraps in every pantry, 50 points each.{best_words}"
msgstr ""
"Otwiera się {leftovers_next_words}, w okolicy Święta Dziękczynienia: "
"{TURKEY_SCRAPS} resztki indyka w każdej spiżarni, po 50 punktów.{best_words}"

#. placeholders: {next_words}
msgid "Bin night opens {next_words}."
msgstr "Noc śmieci otwiera się {next_words}."

#. placeholders: {every}, {next_words}, {best_words}
msgid ""
"Opens {every}, {next_words}: a cheese rind in every pantry, 100 "
"points.{best_words}"
msgstr ""
"Otwiera się {every}, {next_words}: skórka sera w każdej spiżarni, 100 "
"punktów.{best_words}"

msgid ""
"Thanksgiving leftovers: 4 turkey scraps hide in every pantry, 50 points "
"each."
msgstr ""
"Resztki ze Święta Dziękczynienia: w każdej spiżarni chowają się 4 resztki "
"indyka, po 50 punktów."

msgid ""
"The bin is full before collection: a cheese rind hides in every pantry, 100 "
"points."
msgstr ""
"Kosz jest pełny przed wywozem: w każdej spiżarni chowa się skórka sera, 100 "
"punktów."

#. placeholders: {best_words}
#. one sentence of a longer line
msgid "Open from the day before Thanksgiving to 2 days after.{best_words}"
msgstr ""
"Otwarte od dnia przed Świętem Dziękczynienia do 2 dni po nim.{best_words}"

#. one sentence of a longer line
msgid ""
"Thanksgiving leftovers: the pantry run with 4 turkey scraps hidden among "
"the crumbs, 50 points each."
msgstr ""
"Resztki ze Święta Dziękczynienia: bieg przez spiżarnie z 4 resztkami indyka "
"ukrytymi wśród okruszków, po 50 punktów."

#. placeholders: {best_words}
msgid ""
"Thanksgiving leftovers: the pantry run with 4 turkey scraps hidden among "
"the crumbs, 50 points each. Open from the day before Thanksgiving to 2 days "
"after.{best_words}"
msgstr ""
"Resztki ze Święta Dziękczynienia: bieg przez spiżarnie z 4 resztkami indyka "
"ukrytymi wśród okruszków, po 50 punktów. Otwarte od dnia przed Świętem "
"Dziękczynienia do 2 dni po nim.{best_words}"

#. one sentence of a longer line
msgid ""
"Bin night, the first Tuesday of the month: the bin is full before "
"collection, and the pantry run has a cheese rind in every pantry, 100 "
"points."
msgstr ""
"Noc śmieci, pierwszy wtorek miesiąca: kosz jest pełny przed wywozem, a w "
"biegu przez spiżarnie w każdej spiżarni jest skórka sera, 100 punktów."

#. placeholders: {best_words}
msgid ""
"Bin night, the first Tuesday of the month: the bin is full before "
"collection, and the pantry run has a cheese rind in every pantry, 100 "
"points. Open all day.{best_words}"
