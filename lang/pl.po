"Twój atlas: {birds} z {ALL} ptaków, {songs} z {total_songs} pieśni.{opened}"

msgid "Heading home."
msgstr "Wracasz do domu."

#. one sentence of a longer line
msgid "Any other key keeps walking."
msgstr "Każdy inny klawisz idzie dalej."

#. placeholders: {tab}
