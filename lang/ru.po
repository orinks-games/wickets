msgid ""
"You share {count} with the walker, who tells everyone about Larkfield on "
"the way."
msgstr ""
"Вы делитесь с путником: {count}. По дороге он всем рассказывает о Larkfield."

msgid "The walker rests at the gate for a while, then goes on."
msgstr "Путник немного отдыхает у ворот и идёт дальше."

msgid "seed"
msgstr "seed"

#. placeholders: {name}, {name2}
msgid "The seed seller gives you 2 {name} seeds for {name2}."
msgstr "Торговец семенами даёт вам 2 семени, {name}, за {name2}."

msgid "a tune at the gate"
msgstr "мелодия у ворот"

msgid "The busker plays a jig at the gate. Everyone stops work to listen."
msgstr ""
"У ворот уличный музыкант играет джигу. Все бросают работу и слушают."

#. placeholders: {name}
msgid "Someone is at the gate: {name}, asking to stay."
msgstr "У ворот кто-то есть: {name}, просится остаться."

#. placeholders: {who}
msgid "At the gate: {who}."
msgstr "У ворот: {who}."

#. placeholders: {name}
msgid "Overnight, {name}."
msgstr "За ночь: {name}."

msgid ""
"The river is rising after the rain. By supper it will reach the far row of "
"the fields."
msgstr ""
"После дождя река поднимается. К ужину она дойдёт до дальнего ряда полей."

msgid "A hard frost sets in. For 3 days, everyone eats more at supper."
msgstr "Ударил сильный мороз. 3 дня все едят за ужином больше."

msgid "Still bitterly cold. Supper takes more food."
msgstr "Всё ещё лютый холод. Ужин съедает больше еды."

#. placeholders: {name}
msgid "{name} is thinking of leaving Larkfield."
msgstr "{name} подумывает покинуть Larkfield."

