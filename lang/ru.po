msgstr "Чайная открыта. Сегодня {n} {n:гость|гостя|гостей}."

#. placeholders: {n}
#. one sentence of a longer line
msgid "{n} guests this afternoon."
msgstr "Сегодня {n} {n:гость|гостя|гостей}."

