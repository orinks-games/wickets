msgstr "Сегодняшний ужин"

msgid "Sunday dinner"
msgstr "Воскресный обед"

msgid "The harvest banquet"
msgstr "Пир урожая"

msgid "the starter"
msgstr "закуска"

msgid "the main course"
msgstr "основное блюдо"

msgid "dessert"
msgstr "десерт"

msgid "Ten dishes, two on every station."
msgstr "Десять блюд, по два на каждом месте."

msgid "One meal on four stations."
msgstr "Один обед на четырёх местах."

msgid "The starter"
msgstr "Закуска"

msgid "Three stations to warm up."
msgstr "Три места для разминки."

msgid "The main course"
msgstr "Основное блюдо"

msgid "Four stations, quicker."
msgstr "Четыре места, быстрее."

msgid "Dessert"
msgstr "Десерт"

msgid "All five stations, quicker still."
msgstr "Все пять мест, ещё быстрее."

msgid "ten dishes across five stations, with golden plates"
msgstr "десять блюд на пяти местах, с золотыми тарелками"

