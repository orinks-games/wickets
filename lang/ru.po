msgstr "Каждое пятое треснувшее яйцо ломает корзину."

#. placeholders: {DAILY_SECS}
#. one sentence of a longer line
msgid "One {DAILY_SECS}-second round, no egg target."
msgstr "Один раунд на {DAILY_SECS} секунд, без цели по яйцам."

#. placeholders: {DAILY_SECS}, {name}, {describe}
