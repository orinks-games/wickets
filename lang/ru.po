msgid ""
"{sentence_start} and {d} move along the shelf, {l} and {r} choose a cup."
msgstr ""
"{sentence_start} и {d} двигаются вдоль полки, {l} и {r} выбирают чашку."

#. placeholders: {sentence_start}, {d}, {l}, {r}, {p}, {t}, {s}, {rep}, {h}
msgid ""
