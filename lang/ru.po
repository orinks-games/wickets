#. one sentence of a longer line
msgid ""
"Danced so far: {set_count}, {tunes}, {steps_words} in time, {spot_on} of "
"them spot on."
msgstr ""
"Станцовано: {set_count}, {tunes}, в такт {steps_words}, из них в точку "
"{spot_on}."

#. placeholders: {set_count}, {tunes}, {steps_words}, {spot_on}, {steps_words2}, {steps_words3}
msgid ""
"Danced so far: {set_count}, {tunes}, {steps_words} in time, {spot_on} of "
"them spot on. Longest run in time: {steps_words2}. Practice room: "
"{steps_words3}."
msgstr ""
