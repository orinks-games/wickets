msgid "Sets open: {open} of {SETS}.{ceili}"
msgstr "Открыто сетов: {open} из {SETS}.{ceili}"

#. placeholders: {total_stars}
#. one sentence of a longer line
msgid "Stars: {total_stars} of 36."
msgstr "Звёзды: {total_stars} из 36."

