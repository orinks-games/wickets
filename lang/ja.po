msgstr "勝った夜：{nights}晩中{wins}晩。"

#. placeholders: {best}, {wins}, {nights}
msgid "Records. Best night: {best}. Nights won: {wins} of {nights}."
msgstr "記録。ベストの夜：{best}。勝った夜：{nights}晩中{wins}晩。"

msgid "Longest stay: nobody has stayed in for a roll yet."
msgstr "最長の居座り：まだ誰も一回も残っていません。"

msgid "Longest stay: 1 roll in one landing."
msgstr "最長の居座り：一回の寄港で1回。"

#. placeholders: {n}
msgid "Longest stay: {n} rolls in one landing."
msgstr "最長の居座り：一回の寄港で{n}回。"

