msgid "{pressed} closes the tea house."
msgstr "{pressed}で茶屋を閉めます。"

#. placeholders: {pressed}
msgid "{pressed} welcomes the next guest."
msgstr "{pressed}で次のお客さんを迎えます。"

#. one sentence of a longer line
msgid "A long, rainy evening."
msgstr "長い雨の夜。"

#. placeholders: {n}
msgid "A long, rainy evening. {n} guests are on their way."
msgstr "長い雨の夜。お客さんが{n}人向かっています。"

#. placeholders: {n}
#. one sentence of a longer line
msgid "{n} guests are on their way."
msgstr "お客さんが{n}人向かっています。"

msgid ""
"Practice brewing. Brew any tea for yourself, with the exact heat and steep "
"read back."
msgstr "お茶の練習。どのお茶でも自分のために淹れ、正確な温度と蒸らしを聞けます。"

#. one sentence of a longer line
msgid "The tea house is open."
msgstr "茶屋が開きました。"

#. placeholders: {n}
msgid "The tea house is open. {n} guests this afternoon."
msgstr "茶屋が開きました。今日の午後のお客さんは{n}人。"

#. placeholders: {n}
#. one sentence of a longer line
msgid "{n} guests this afternoon."
msgstr "今日の午後のお客さんは{n}人。"

#. placeholders: {head}, {name}
msgid "{head} {name} is on the shelf."
msgstr "{head}{name}が棚に並んでいます。"

#. placeholders: {name}
msgid " A special guest is due today, for {name}."
msgstr "今日は{name}の特別なお客さんが来る予定です。"

#. placeholders: {p}
#. one sentence of a longer line
msgid "{p} chooses, heats, pours and lifts the leaves."
msgstr "{p}で選ぶ、沸かす、注ぐ、茶葉を引き上げる。"

