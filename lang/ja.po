msgstr "ダイヤルは数字の上ですが、{word}回しで届いています。少し{word2}に回してから、{word3}回しで戻りましょう。"

#. placeholders: {word2}, {word3}
#. one sentence of a longer line
msgid "Turn a little {word2}, then come back turning {word3}."
msgstr "少し{word2}に回してから、{word3}回しで戻りましょう。"

msgid "The dial is on the number. Set it."
msgstr "ダイヤルは数字の上です。合わせましょう。"

#. placeholders: {word}, {word2}
#. one sentence of a longer line
msgid "Turn back {word} past it, then come forward turning {word2}."
msgstr "{word}に回して越えてから、{word2}回しで進みましょう。"

#. placeholders: {words}
#. one sentence of a longer line
msgid "You have just passed it: it is {words} behind you."
msgstr "今、通り過ぎました。{words}戻ったところです。"

