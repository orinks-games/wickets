msgid "Right arrow: move to the next pipe up the rank."
msgstr "Right: zur nächsten Pfeife höher im Register."

msgid "Tab: play the true note alone for a moment."
msgstr "Tab: den echten Ton kurz allein spielen."

msgid ""
