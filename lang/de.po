msgid ""
"{sentence_start} speaks air, hull and the bell, twice for the rest. "
"{sentence_start2} gives a hint. {sentence_start3} drops a marker buoy. "
"{sentence_start4} repeats. Escape pauses."
msgstr ""
"{sentence_start} nennt Luft, Rumpf und Glocke, zweimal für den Rest. "
"{sentence_start2} gibt einen Tipp. {sentence_start3} setzt eine "
"Markierungsboje. {sentence_start4} wiederholt. Escape pausiert."

#. placeholders: {number}, {depth}
msgid "Dive {number}, {depth} down."
msgstr "Tauchgang {number}, {depth} tief."

msgid " The galleon lies near the edge of the site, ringed by mines."
msgstr " Die Galeone liegt nah am Rand des Gebiets, umringt von Minen."

