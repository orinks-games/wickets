msgstr "{time} em {name}, um pote de {jar}"

#. placeholders: {time}, {name}
msgid "{time} in {name}"
msgstr "{time} em {name}"

msgid ""
"10 points a firefly, 25 a species, and 40 for each named chord you set free."
msgstr ""
"10 pontos por vaga-lume, 25 por espécie e 40 por acorde com nome que você "
"soltar."

msgid "A summer evening from the almanac"
msgstr "Uma noite de verão do almanaque"

msgid "A small jar, so chords come quickly"
msgstr "Um pote pequeno, para os acordes virem rápido"

msgid "A long evening in the hayfield, with every hayfield firefly out"
msgstr ""
"Uma noite longa no campo de feno, com todos os vaga-lumes do campo de feno "
"fora"

